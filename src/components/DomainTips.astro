---
---

<section class="py-12 bg-blue-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
        <span data-i18n="tips.title">💡 Tips para Mejores Resultados</span>
      </h3>
      
      <div class="grid md:grid-cols-2 gap-6">
        <div class="space-y-4">
          <div class="flex gap-3">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-green-100 text-green-600 rounded-full flex items-center justify-center font-bold">
                ✓
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1" data-i18n="tips.do1.title">Usa palabras cortas y memorables</h4>
              <p class="text-sm text-gray-600" data-i18n="tips.do1.desc">
                Ejemplo: "tech", "shop", "pro", "fast"
              </p>
            </div>
          </div>

          <div class="flex gap-3">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-green-100 text-green-600 rounded-full flex items-center justify-center font-bold">
                ✓
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1" data-i18n="tips.do2.title">Combina español e inglés</h4>
              <p class="text-sm text-gray-600" data-i18n="tips.do2.desc">
                Ejemplo: "mitech", "shopexpress", "proventas"
              </p>
            </div>
          </div>

          <div class="flex gap-3">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-green-100 text-green-600 rounded-full flex items-center justify-center font-bold">
                ✓
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1" data-i18n="tips.do3.title">Prueba múltiples extensiones</h4>
              <p class="text-sm text-gray-600" data-i18n="tips.do3.desc">
                Si .com no está disponible, prueba .io, .dev, .app
              </p>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div class="flex gap-3">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-red-100 text-red-600 rounded-full flex items-center justify-center font-bold">
                ✗
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1" data-i18n="tips.dont1.title">Evita palabras muy largas</h4>
              <p class="text-sm text-gray-600" data-i18n="tips.dont1.desc">
                Difíciles de recordar y escribir
              </p>
            </div>
          </div>

          <div class="flex gap-3">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-red-100 text-red-600 rounded-full flex items-center justify-center font-bold">
                ✗
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1" data-i18n="tips.dont2.title">No uses guiones o números</h4>
              <p class="text-sm text-gray-600" data-i18n="tips.dont2.desc">
                Pueden confundir a los usuarios
              </p>
            </div>
          </div>

          <div class="flex gap-3">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-red-100 text-red-600 rounded-full flex items-center justify-center font-bold">
                ✗
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-1" data-i18n="tips.dont3.title">Evita marcas registradas</h4>
              <p class="text-sm text-gray-600" data-i18n="tips.dont3.desc">
                Pueden causar problemas legales
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 p-4 bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg border-2 border-blue-200">
        <p class="text-sm text-gray-700">
          <strong class="text-primary-600" data-i18n="tips.proTip.label">💡 Pro Tip:</strong> <span data-i18n="tips.proTip.text">Los dominios cortos y descriptivos son más fáciles de recordar y tienen mejor posicionamiento SEO. Nuestro sistema generará automáticamente cientos de combinaciones basadas en tus palabras clave.</span>
        </p>
      </div>
    </div>
  </div>
</section>
